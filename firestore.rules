rules_version = '2';

// FlashPlay security rules.
//
// This app is serverless: the client reads Firestore directly, so these rules
// are the only enforcement boundary that exists. Nothing here is a convenience
// or a second line of defence - if a rule is wrong, the game is broken and a
// player with devtools open can read the answer.
//
// One shape covers the two things that must stay hidden, because they are the
// same problem (DESIGN.md, "One pattern for the security rules"):
//
//     writes permitted to the owner only,
//     reads permitted only after the phase has passed.
//
// It applies to who wrote an item, and to how everyone voted. Anywhere else
// that needs to hide something until a moment arrives should reuse it rather
// than invent a second mechanism.
//
// `get` vs `read`/`list`: written deliberately throughout this file rather
// than left to accident. `read` grants both a single-document `get` and a
// collection `list`; a condition that never mentions the document/collection
// wildcard grants `list` too, even when only `get` was intended - that gap is
// what let every gathering on the project be enumerated in the first
// milestone-2 review. Every rule below is `get` unless a comment says
// listing is actually needed.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers ------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // DESIGN: "A registered host (Google, one tap) is required to open a
    // gathering." Every real Firebase Auth token carries a
    // `firebase.sign_in_provider` claim - `'anonymous'` for a guest,
    // `'google.com'` for a host - so checking for the one value that means
    // "guest" is enough; there is no real token where this claim is absent.
    // (An independent review found the emulator's default mock token DOES
    // omit it, which made an early version of this check pass vacuously for
    // "registered" tests rather than for the right reason - see
    // firestore-rules.test.ts, which now sets a realistic claim explicitly.)
    function isRegistered() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Milestone-3 room-code lifecycle: a code reservation lives at most this
    // long before it can be reclaimed by a new gathering. Mirrors
    // ROOM_CODE_WINDOW_MS in src/lib/model.ts - rules cannot import from
    // there, so the two are kept in step by the emulator tests, the same way
    // ITEM_WRITE_ORDER is.
    function maxRoomCodeWindowMs() {
      return 12 * 60 * 60 * 1000;
    }

    function session(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    function isHost(sessionId) {
      return isSignedIn() && session(sessionId).hostUid == request.auth.uid;
    }

    // Milestone 4: used both to gate writes to the phase actually in progress
    // (a submission after the host has moved on must not silently succeed)
    // and to find a PromptSubmissionDoc, whose path includes gameId - see
    // itemAuthors create, below.
    function game(sessionId, gameId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)/games/$(gameId)).data;
    }

    // The one-submission-per-player-per-prompt slot - see PromptSubmissionDoc
    // in src/lib/model.ts. Used by `itemAuthors` create, which is the one
    // place in the sequence that has to check a claim against the slot that
    // reserved it; `items` create cross-checks the claim instead, since by
    // then the claim already carries the same gameId/promptId.
    function promptSubmission(sessionId, gameId, promptId, uid) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)/games/$(gameId)/prompts/$(promptId)/submissions/$(uid)).data;
    }

    // Membership is "you have a player document in this gathering". Holding the
    // link is not enough on its own: the link is a bearer token that can be
    // forwarded out of the group, so joining has to leave a trace that the
    // rules can check.
    function isPlayer(sessionId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/sessions/$(sessionId)/players/$(request.auth.uid));
    }

    // A gathering only ever moves forward. Without this the host could set
    // phase to 'finished', read the answer key through the rule below, and set
    // it back - and the host is a scoring player. Ending the gathering to peek
    // now costs the gathering.
    function phaseRank(phase) {
      return phase == 'lobby' ? 0
        : phase == 'playing' ? 1
        : phase == 'finished' ? 2
        : -1;
    }

    function itemRevealed(sessionId, itemId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)/items/$(itemId))
        .data.revealed == true;
    }

    function roundRevealed(sessionId, roundId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)/rounds/$(roundId))
        .data.phase == 'revealed';
    }

    // Milestone 5. `skipped` and `revealed` share a rank because both are
    // terminal: what matters is that nothing ever moves back down, since a
    // round's votes become readable at `revealed` and must not become
    // unreadable-but-already-seen again. Mirrors RoundPhase in
    // src/lib/model.ts.
    function roundPhaseRank(phase) {
      return phase == 'preview' ? 0 : (phase == 'voting' ? 1 : 2);
    }

    // Whether the gathering is inside its round loop right now - the one
    // window DESIGN closes joining in. Written as a short-circuit so that a
    // gathering with no game yet never reaches the second get(): a get() on a
    // document that does not exist fails the whole evaluation rather than
    // returning nothing.
    function inRoundLoop(sessionId) {
      return session(sessionId).currentGameId != null
        && game(sessionId, session(sessionId).currentGameId).phase == 'rounds';
    }

    function round(sessionId, roundId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)/rounds/$(roundId)).data;
    }

    // Whether this round's item has already been revealed, which is what makes
    // its author readable - so voting must already be closed. See the votes
    // rules below. Mutation-checked on 2026-09-14: dropping the clause that
    // uses this turned exactly "refuses a vote once the item is revealed, even
    // if the round still says voting" red.
    //
    // **Only in "who said that".** In "most likely to" every item is revealed
    // before the game even starts - that is what the game is built from - and
    // the author is named in the question itself, so there is nothing for a
    // revealed item to give away. Written without the game-type check first,
    // this clause silently forbade every vote in the second game; the second
    // game's own suite caught it.
    function authorExposed(sessionId, roundId) {
      return game(sessionId, round(sessionId, roundId).gameId).type == 'who-said-that'
        && itemRevealed(sessionId, round(sessionId, roundId).itemId);
    }

    // A self-vote is refused in "who said that" and allowed in "most likely
    // to". In the first game abstaining or voting for yourself would mark the
    // author out, which is the whole reason they vote at all. In the second
    // there is nothing to hide and "me" is often the honest answer - and the
    // author of the item being discussed is the likeliest majority pick, so
    // barring them from it would exclude one named person from the scoring
    // every round (found in the milestone-6 review).
    function selfVoteAllowed(sessionId, roundId) {
      return game(sessionId, round(sessionId, roundId).gameId).type == 'most-likely-to';
    }

    // A vote always names someone who is really in this gathering. Whether it
    // may name the voter depends on the game - see selfVoteAllowed above.
    // Mutation-checked on 2026-09-14: each clause, removed on its own, turned
    // exactly one assertion red ("refuses a self-vote in the first game" and
    // "refuses a vote for somebody who is not in this gathering").
    function validVote(sessionId, roundId, playerId) {
      return request.resource.data.keys().hasOnly(['votedForPlayerId', 'castAt'])
        && (request.resource.data.votedForPlayerId != playerId
            || selfVoteAllowed(sessionId, roundId))
        && exists(/databases/$(database)/documents/sessions/$(sessionId)/players/$(request.resource.data.votedForPlayerId));
    }

    // --- the host's private store -------------------------------------------
    //
    // Contacts, groups and the accumulated facts belong to the user who owns
    // them and are readable by nobody else - explicitly including people who
    // are in that user's gathering right now. A gathering copies in only the
    // items actually in play; without this line a guest could read a family's
    // entire accumulated memory (DESIGN.md, "The link is a bearer token").

    match /users/{uid} {
      allow read, write: if isUser(uid);

      match /{document=**} {
        allow read, write: if isUser(uid);
      }
    }

    // --- the room-code lookup ------------------------------------------------
    //
    // Maps the short human-facing code to a session's real (unguessable) id.
    // `get` only, same reasoning as sessions below: a client must already
    // know the code to resolve it, and there is no query-based lookup by
    // design - `list` here would let a code be found by sweeping instead of
    // by receiving a join link.
    match /roomCodes/{code} {
      allow get: if isSignedIn();

      // A fresh reservation: only a registered host may open one, naming a
      // session that already exists and is actually theirs - an independent
      // review of the first version of this found that nothing checked the
      // claim actually pointed where it said: a client could name any
      // sessionId and hostUid it liked. `src/lib/room.ts` creates the session
      // before claiming its code specifically so this `get()` has something
      // real to check. The window is bounded on both ends - not already
      // expired (a code cannot be born reclaimable) and not further out than
      // the maximum window (or a host could reserve a code indefinitely,
      // which is exactly the permanent-squatting problem this collection
      // exists to remove).
      allow create: if isRegistered()
        && request.resource.data.hostUid == request.auth.uid
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
             .data.hostUid == request.auth.uid
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + maxRoomCodeWindowMs();

      // Reclaiming an expired code. Firestore evaluates a write to an id that
      // already has a document as `update`, not `create` - regardless of
      // whether the client called setDoc or updateDoc - which is why this is
      // a separate rule rather than a condition on create. The existing
      // reservation must actually be expired; the new one is bounded and
      // session-checked exactly as a fresh create would be.
      allow update: if isRegistered()
        && resource.data.expiresAt < request.time.toMillis()
        && request.resource.data.hostUid == request.auth.uid
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
             .data.hostUid == request.auth.uid
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + maxRoomCodeWindowMs();

      // No legitimate flow deletes a code directly - expiry-then-reclaim is
      // the only lifecycle. Same "remove the failure mode" reasoning as
      // items' delete rule.
      allow delete: if false;
    }

    // --- the live gathering -------------------------------------------------

    match /sessions/{sessionId} {
      // `get`, not `read`. Granting `list` here let anyone enumerate every
      // gathering on the project - room codes, hosts, scores - with no join
      // link at all (found in the milestone-2 review). A client must already
      // know the sessionId to read one; there is no query-based lookup by
      // room code. Milestone 3 made the id itself an unguessable random
      // string rather than the room code (see roomCodes below and
      // SessionDoc.roomCode in src/lib/model.ts) - `get`-only stays exactly
      // as necessary, since a guest now reaches a session by resolving a code
      // through roomCodes first, never by guessing or listing this id.
      allow get: if isSignedIn();

      // Only a registered host may open a gathering (DESIGN.md, "Identity and
      // data") - a guest's anonymous token fails isRegistered(). Enforced
      // here, not just by hiding the button, for the same reason every other
      // rule in this file exists: the client cannot be trusted to enforce its
      // own product rules.
      allow create: if isRegistered() && request.resource.data.hostUid == request.auth.uid;

      // Phase never goes backwards, and the host never changes. The first
      // guard is what stops the host peeking at authorship mid-game (they
      // would have to end the gathering to do it); the second stops a host
      // locking themselves out of their own room by mistake.
      allow update: if isHost(sessionId)
        && phaseRank(request.resource.data.phase) >= phaseRank(resource.data.phase)
        && request.resource.data.hostUid == resource.data.hostUid;

      // Deleting a session does NOT delete its subcollections - the players,
      // items and author claims survive, becoming orphaned garbage rather
      // than a re-creation risk now that the id is unguessable (milestone 3):
      // nobody can target that specific id to inherit them. Still denied,
      // because there is no legitimate reason to delete one and the cleanup
      // that would make deletion meaningful (removing the subcollections too)
      // needs a server this app deliberately doesn't have; expiry is handled
      // one level up, on the room code that points here, not on this
      // document. See DECISIONS.md, "room-code lifecycle (milestone 3)".
      allow delete: if false;

      // --- players ---
      // Document id is the player's uid, so a player structurally cannot write
      // someone else's presence or rename them.
      //
      // Read requires `isPlayer`, not just `isSignedIn`: the roster holds real
      // names, and the milestone-2 review read a full family's names without
      // ever joining. Joining itself only needs `isSignedIn` (create, below),
      // so this does not block a first-time join - you create your own player
      // doc, which is what makes `isPlayer` become true, and only then can you
      // read the roster.
      match /players/{playerId} {
        allow read: if isPlayer(sessionId);

        // DESIGN: "Joining is permitted between games and also during the
        // submission phase, and blocked only inside the round loop." Someone
        // arriving mid-harvest just submits too; someone arriving mid-round
        // would become a vote option in a round they never heard, and could
        // vote on an item they had no part in. Milestone 5 - milestone 4 read
        // the same sentence and only implemented its first half.
        // Mutation-checked on 2026-09-14: dropping the round-loop clause
        // turned exactly "refuses a join once the round loop has started" red.
        allow create: if isSignedIn() && playerId == request.auth.uid
          && !inRoundLoop(sessionId);
        allow update: if isUser(playerId) || isHost(sessionId);
        allow delete: if isUser(playerId) || isHost(sessionId);
      }

      // --- playerNames ---
      // One slot per normalised display name, id-locked so first-write-wins
      // is structural - see PlayerNameDoc in model.ts for why this exists
      // (two structurally different players sharing a display name makes
      // every screen that names a player by looking it up ambiguous about
      // which one is meant). `get` is open to anyone signed in, not just
      // players of this session: a first-time guest checking a name before
      // they have a player document of their own is exactly the caller this
      // exists to unblock, and a name-in-use bit leaks nothing.
      // Never updatable or deletable, even by the host - matching
      // itemAuthors/PromptSubmissionDoc, since releasing a name mid-gathering
      // recreates the exact ambiguity this is meant to prevent.
      match /playerNames/{name} {
        allow get: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid']);
      }

      // --- games ---
      match /games/{gameId} {
        allow read: if isPlayer(sessionId);

        // Shape-checked on create only - see BACKLOG.md, "sessions create
        // doesn't constrain phase/scores", the same "routine" reasoning
        // applies to update (the host can always drive their own gathering
        // wherever they like; there is no cross-user exposure in it).
        //
        // **Except `type`, which is now security-relevant.** The vote guard
        // below (`authorExposed`) only applies to `who-said-that` rounds,
        // because in "most likely to" every item is revealed by design. A
        // review on 2026-09-14 showed what that meant while `type` stayed
        // freely writable: flip the game to `most-likely-to`, reveal an item,
        // read its author, change your vote, flip the type back - and nothing
        // records that it ever happened. Narrowing a security predicate by a
        // document field makes that field part of the boundary, so it is
        // pinned in the same change that narrowed the predicate.
        // Each game type opens in the only phase that makes sense for it.
        // "Most likely to" has no harvest at all - it is built from the items
        // the first game revealed, so it starts in `rounds` with no prompts of
        // its own (DESIGN, "Most likely to").
        allow create: if isHost(sessionId)
          && (
            (
              request.resource.data.type == 'who-said-that'
              && request.resource.data.phase == 'harvesting'
              // Mirrors PROMPTS_PER_GATHERING in src/content/prompts.ts.
              && request.resource.data.promptIds.size() == 2
            ) || (
              request.resource.data.type == 'most-likely-to'
              && request.resource.data.phase == 'rounds'
              && request.resource.data.promptIds.size() == 0
            )
          );
        // Mutation-checked on 2026-09-14: dropping the type clause turned
        // exactly "refuses to change a game's type after it has started" red.
        allow update: if isHost(sessionId)
          && request.resource.data.type == resource.data.type;
        allow delete: if false;

        // --- one submission slot per player per prompt: "duplicate
        // blocking" (MILESTONES.md, milestone 4) ---
        //
        // See PromptSubmissionDoc in src/lib/model.ts for why the document id
        // being the player's own uid, rather than a shared first-write-wins
        // slot, is what makes this safe against being front-run and blocked:
        // only `uid` itself can ever call create here, so there is nothing
        // for another player to race.
        match /prompts/{promptId} {
          match /submissions/{uid} {
            // `get`, and only your own slot. The first version of this rule
            // was `read: if isPlayer(sessionId)`, which handed every player
            // the answer key: this document pairs a player's uid with their
            // item id, and `items` is readable by every player, so listing
            // this collection reconstructs precisely the author-to-item
            // mapping `itemAuthors` exists to hide until the reveal. It also
            // published the one value ITEM_WRITE_ORDER requires to stay
            // unguessable, so another player could copy a victim's itemId
            // into their own slot, claim it first, and permanently block that
            // person's submission. Found by an independent security review on
            // 2026-09-08. Nothing legitimate needs another player's slot:
            // getMySubmission() reads its own, and useHarvestProgress()
            // counts `items`.
            // Mutation-checked on 2026-09-08: widening this back to
            // `read: if isPlayer(sessionId)` turned exactly "refuses a player
            // another player's slot, and refuses listing them to anyone"
            // red, and nothing else.
            allow get: if isUser(uid) && isPlayer(sessionId);
            allow create: if isUser(uid) && isPlayer(sessionId)
              && game(sessionId, gameId).phase == 'harvesting'
              && request.resource.data.keys().hasOnly(['itemId', 'submittedAt'])
              && request.resource.data.itemId is string;
            // Never updatable: a second attempt for the same prompt is
            // exactly the duplicate this collection exists to block, and
            // reusing an already-spent slot for a different item would let a
            // player edit an already-checked-in answer without the item
            // rules ever seeing it happen. Mutation-checked: temporarily
            // allowing update turned exactly "refuses a second reservation
            // for the same prompt" red, and nothing else.
            allow update: if false;
            allow delete: if isHost(sessionId);
          }
        }
      }

      // --- harvested items: PUBLIC, text only ---
      //
      // Deliberately contains no author - see itemAuthors below, which an item
      // can only be created after claiming.
      //
      // `revealed` can only ever flip false -> true, and only the host can do
      // it. This is what closes the milestone-2 review's S1: previously a
      // player could delete-then-recreate an item with `revealed: true` set
      // directly, which opened its itemAuthors document as a side effect.
      // Deletion is removed entirely rather than restricted, per "prefer
      // removing a failure mode to tuning it" - there is no legitimate reason
      // to delete an item mid-gathering, and every value of a delete rule here
      // was wrong.
      match /items/{itemId} {
        allow read: if isPlayer(sessionId);

        // An item may only be created by the player who has already claimed
        // authorship of this exact id in itemAuthors. See itemAuthors below
        // for why that claim cannot be raced or observed in advance - this is
        // what closes S4 (authorship could otherwise be stolen between the
        // two writes).
        //
        // Milestone 4 adds three checks on top: the item's declared
        // gameId/promptId must match what the (earlier-written) itemAuthors
        // claim actually recorded - otherwise a player could reserve one
        // prompt's submission slot and spend it on an item tagged as a
        // different prompt, defeating the one-per-prompt cap - the game must
        // still be in its harvesting phase (a submission after the host has
        // moved the gathering on to rounds must not silently create an item
        // nobody expects), and the text is bounded, since it is PUBLIC and
        // rendered on every phone in the room the instant it lands.
        allow create: if isPlayer(sessionId)
          && request.resource.data.revealed == false
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          // Mirrors ITEM_TEXT_MAX_LENGTH in src/lib/model.ts - rules cannot
          // import from there, so this is kept in step by the emulator
          // tests, the same way maxRoomCodeWindowMs() is.
          && request.resource.data.text.size() <= 300
          && get(/databases/$(database)/documents/sessions/$(sessionId)/itemAuthors/$(itemId))
               .data.authorPlayerId == request.auth.uid
          && get(/databases/$(database)/documents/sessions/$(sessionId)/itemAuthors/$(itemId))
               .data.gameId == request.resource.data.gameId
          && get(/databases/$(database)/documents/sessions/$(sessionId)/itemAuthors/$(itemId))
               .data.promptId == request.resource.data.promptId
          // Mutation-checked: removing this clause turned exactly "refuses
          // an item created after the game has moved past harvesting" red.
          && game(sessionId, request.resource.data.gameId).phase == 'harvesting';

        // Only the `revealed` flag may change on this write - an independent
        // review found that constraining the flag alone left every other
        // field open, so the host could rewrite `text` in the very update
        // that reveals it. Milestone 0's decision that an item's text passes
        // into the second game untouched depends on this: the host is a
        // scoring player, and a host who can edit an answer at reveal time
        // can frame anyone for anything.
        allow update: if isHost(sessionId)
          && request.resource.data.revealed == true
          && resource.data.revealed == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revealed']);

        allow delete: if false;
      }

      // --- who wrote each item ---
      //
      // This is the rule the first game depends on entirely. If it is wrong,
      // "Who said that" is not a guessing game.
      //
      // Readable two ways: any player, once the item is revealed - the normal
      // path, during play. Or the host alone, once the gathering has
      // finished - this is how the items that were never revealed get
      // attributed when they are written as facts (DESIGN.md, "Who said
      // that": unrevealed items are "kept as facts for future gatherings",
      // and every fact is attributed to its author in storage). Without this
      // second path an unrevealed item's author would be unreadable by
      // anyone, forever, including the host - there is no server to make an
      // exception from. `get` only in both cases: a reader already knows
      // which itemId they want, either because it was just revealed to them
      // or because the host is iterating ids already listed from `items`.
      match /itemAuthors/{itemId} {
        allow get: if (isPlayer(sessionId) && itemRevealed(sessionId, itemId))
          || (isHost(sessionId) && session(sessionId).phase == 'finished');

        // Written first, before the matching item exists - see items above.
        // A `create` rule only ever fires once per document id (the doc must
        // not already exist), and this collection can never be listed, so
        // there is no way to discover or race a claim in advance.
        // The claim must precede its item, which is also what stops a claim
        // being rewritten: the host may delete a claim, and without this
        // condition delete-then-create would be an update by another route,
        // letting a player take authorship of an already-revealed item.
        //
        // Milestone 4: the claim must also point at a PromptSubmissionDoc
        // this same caller already reserved for this exact item id - the
        // slot that "duplicate blocking" is enforced through (see
        // games/{gameId}/prompts/{promptId}/submissions above). Without this
        // cross-check a player could skip reserving a slot entirely and claim
        // as many items as they liked for one prompt.
        allow create: if isPlayer(sessionId)
          && request.resource.data.authorPlayerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorPlayerId', 'gameId', 'promptId'])
          // Mutation-checked: removing this cross-check turned exactly
          // "refuses an authorship claim naming an item id its slot did not
          // reserve" red.
          && promptSubmission(sessionId, request.resource.data.gameId, request.resource.data.promptId, request.auth.uid).itemId == itemId
          && !exists(/databases/$(database)/documents/sessions/$(sessionId)/items/$(itemId));
        // Never updatable - otherwise a player could rewrite history after
        // the reveal.
        allow update: if false;
        allow delete: if isHost(sessionId);
      }

      // --- rounds ---
      match /rounds/{roundId} {
        allow read: if isPlayer(sessionId);

        // A round opens in `preview`: the host sees the item before the room
        // does, which is what the skip button acts on (DESIGN, "Who said
        // that").
        allow create: if isHost(sessionId)
          && request.resource.data.phase == 'preview'
          && request.resource.data.keys().hasOnly(['gameId', 'itemId', 'phase', 'order', 'startedAt']);

        // **Phase only moves forward.** Not tidiness: the votes of a round
        // become readable the moment it is `revealed` (below), so a host who
        // could set `revealed` and then step back to `voting` would read
        // every vote and still be free to change their own. Same shape as the
        // session's own monotonic phase, and for the same reason.
        //
        // Both clauses mutation-checked on 2026-09-14: dropping the rank
        // comparison turned exactly "refuses to move a revealed round back to
        // voting" red, and dropping the itemId equality turned exactly
        // "refuses to swap the item under a round that is already open" red.
        //
        // Two shapes of update, and nothing else. Moving the phase forward
        // (and only the phase), or recording once what the round paid out -
        // see RoundDoc.awarded: the gathering's totals are the sum of those
        // maps, so a second write to one would pay a round twice.
        allow update: if isHost(sessionId)
          && request.resource.data.itemId == resource.data.itemId
          && request.resource.data.gameId == resource.data.gameId
          && (
            (
              request.resource.data.phase in ['voting', 'revealed', 'skipped']
              && roundPhaseRank(request.resource.data.phase) > roundPhaseRank(resource.data.phase)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
            ) || (
              resource.data.phase == 'revealed'
              && request.resource.data.phase == 'revealed'
              // Mutation-checked on 2026-09-14: dropping this turned exactly
              // "records what the round paid, once and only once" red.
              && !resource.data.keys().hasAny(['awarded'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['awarded'])
            )
          );

        // A skipped round is a `phase`, not a deletion - deleting it would put
        // the item back in the draw the host just rejected it from, and a
        // round's votes are a subcollection that would outlive it, so
        // delete-and-recreate would walk a phase backwards by another route.
        // Mutation-checked on 2026-09-14: opening this to the host turned
        // exactly "refuses to delete a round, host included" red.
        allow delete: if false;

        // --- votes ---
        //
        // Same shape as itemAuthors, for the same reason: seeing the votes as
        // they land would turn the round into a poll where everyone follows
        // the first vote.
        //
        // Document id is the voting player's uid, so double voting is
        // structurally impossible rather than merely checked.
        //
        // Unlike itemAuthors, `read` (not `get`) is deliberate here: once a
        // round is revealed, players are expected to see the full breakdown
        // of who voted for whom, which needs `list`.
        match /votes/{playerId} {
          allow read: if isPlayer(sessionId) && roundRevealed(sessionId, roundId);

          // A player may always read back their own vote - they need to see
          // what they picked while the round is still open.
          allow get: if isUser(playerId) && isPlayer(sessionId);

          // Both create and update require the round still open. Create had
          // no such guard before the milestone-2 review (S3): a player who
          // never voted has no document yet, so their write after the reveal
          // was a create, not an update, and the existing update guard never
          // saw it.
          //
          // Milestone 5 adds the shape, and two things the vote must be: for
          // somebody who is actually in this gathering, and never for
          // yourself. The second is the game's own rule made structural - the
          // author votes too, for someone else, precisely so that abstaining
          // or self-voting cannot mark them out (DESIGN, "Who said that").
          //
          // `!authorExposed` is belt and braces on ROUND_REVEAL_ORDER (see
          // src/lib/model.ts). Revealing is two writes - close the round, then
          // open the author - and an independent review on 2026-09-14 found
          // that with those two in the other order, the gap between them let a
          // player read the author off the live items listener and change
          // their vote to match. The client order is fixed; this makes the
          // window unexploitable even if a future change reverses it again.
          allow create: if isUser(playerId) && isPlayer(sessionId)
            && !roundRevealed(sessionId, roundId)
            && !authorExposed(sessionId, roundId)
            && validVote(sessionId, roundId, playerId);
          allow update: if isUser(playerId) && isPlayer(sessionId)
            && !roundRevealed(sessionId, roundId)
            && !authorExposed(sessionId, roundId)
            && validVote(sessionId, roundId, playerId);
          allow delete: if isHost(sessionId);
        }
      }
    }

    // Anything not matched above is denied. Stated explicitly so that adding a
    // collection without adding rules fails loudly instead of silently.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

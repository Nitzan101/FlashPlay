# Copy to .env.local (gitignored) and fill in from the Firebase console:
# Project settings > General > Your apps > flashplay (web) > SDK setup and configuration.
# These values are not secret (they run in client-side code and ship in the
# bundle) - real access control is Firestore security rules, not this file.
# The only reason they live in env vars rather than committed source is to
# make it structurally impossible to accidentally point a dev build at the
# wrong Firebase project (e.g. the live Imposter Game one).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
